# .env for the LIVE site (Hostinger). Copy this to .env on the server and fill in the <...> values.
# Never upload your computer's .env: it has local-only test switches.

APP_NAME=InvestmentPoint
APP_ENV=production
# Same APP_KEY as on your computer (otherwise logins and encrypted data break)
APP_KEY=<copy from local .env>
APP_DEBUG=false
# Without www: the address approved in Razorpay (www is redirected here by public/.htaccess)
APP_URL=https://investmentpoint.in

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database from Hostinger -> Databases (never use root without a password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<hostinger database name>
DB_USERNAME=<hostinger database user>
DB_PASSWORD=<strong database password>

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Sessions: https-only cookies; members and admins are logged out after 2 hours of inactivity
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Site emails (article emails, blog-approved emails): Gmail + App Password
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=shreeinvestmentpoint@gmail.com
MAIL_PASSWORD=<gmail app password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=shreeinvestmentpoint@gmail.com
MAIL_FROM_NAME="Investment Point"

# Secret admin address (same as on your computer, or a new one only you know)
ADMIN_PATH=<secret admin path>
ADMIN_IDLE_MINUTES=60

# Online payment: real Razorpay keys (rzp_live_...). Without them subscriptions can't be paid.
RAZORPAY_KEY=<rzp_live_...>
RAZORPAY_SECRET=<razorpay secret>

# Local test switches - must stay OFF here. (The code also refuses them when APP_ENV=production.)
OTP_DEMO=false
SUBSCRIPTION_DEMO_PAYMENTS=false

# WhatsApp via Secondtick (app.secondtick.com -> Settings -> API Access): member login OTP + "subscription active" message
WHATSAPP_PROVIDER=secondtick
SECONDTICK_API_URL=https://app.secondtick.com/api
SECONDTICK_VENDOR_UID=<copy from local .env>
SECONDTICK_TOKEN=<copy from local .env>
WHATSAPP_OTP_TEMPLATE=<copy from local .env>
WHATSAPP_OTP_TEMPLATE_LANGUAGE=<copy from local .env>
WHATSAPP_TEMPLATE=<copy from local .env>
WHATSAPP_TEMPLATE_LANGUAGE=<copy from local .env>

# AI pictures / news writer (same values as on your computer)
HF_TOKEN=<copy from local .env>
AI_IMAGE_DAILY_LIMIT=20

# Prices refresh every 15 seconds (lower = more server load)
MARKET_CACHE_SECONDS=15
MARKET_IMPORT_DUTY=15
MARKET_GST=3
