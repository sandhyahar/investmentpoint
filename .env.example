APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Google Gemini (aistudio.google.com): articles, titles and translations (text only). Usually pasted in
# Admin -> Settings -> Gemini AI instead of here.
GEMINI_API_KEY=
# Free backup for text: Groq (console.groq.com, or Admin -> Settings)
GROQ_API_KEY=
# AI pictures, free services only, tried in this order:
#   Cloudflare Workers AI (dash.cloudflare.com, token with "Workers AI" permission) -> about 100 pictures a day
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
#   Pollinations.ai: works without a key (small logo in a corner); a free key from enter.pollinations.ai removes it
POLLINATIONS_API_KEY=
#   Hugging Face FLUX Space (~3/day without a token; a free token from huggingface.co/settings/tokens gives more)
HF_TOKEN=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SEO / Google (fill in after the site is live)
GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=

# Admin panel security (live site)
ADMIN_PATH=admin
ADMIN_IDLE_MINUTES=60
# Only when creating/resetting the admin login with: php artisan db:seed --class=AdminUserSeeder (remove afterwards)
ADMIN_PASSWORD=

# Production: never show error details, cookies only over https
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true

# Block right-click / Inspect / copy on the public site (default: on when APP_ENV=production)
# CONTENT_PROTECTION=true

# Admin panel on phones, tablets and computers. Set true to allow computers / laptops only.
ADMIN_DESKTOP_ONLY=false

# Gold / Silver in India: world price + import duty + GST (percent)
MARKET_IMPORT_DUTY=15
MARKET_GST=3

# Subscription payments (Razorpay). Empty = demo payment button; rzp_test_ keys = test mode; rzp_live_ keys = real payments
RAZORPAY_KEY=
RAZORPAY_SECRET=
# true = free "Complete demo payment" button while there are no keys. LOCAL TESTING ONLY - keep false on the live site
SUBSCRIPTION_DEMO_PAYMENTS=false

# WhatsApp (login OTP + "subscription confirmed" message). Empty = no OTP; admin sends the confirmation with one click.
# secondtick = via app.secondtick.com (Settings -> API Access); meta = WhatsApp Cloud API directly (token + phone number id)
WHATSAPP_PROVIDER=secondtick
SECONDTICK_API_URL=https://app.secondtick.com/api
SECONDTICK_VENDOR_UID=
SECONDTICK_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 4 body values: {{1}} name, {{2}} plan, {{3}} start date, {{4}} expiry date
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Real stock photos for news pictures and the admin "Find real photo" button (free: pexels.com/api)
PEXELS_API_KEY=
# ...or Pixabay (free key shown on pixabay.com/api/docs after you log in). Used when set.
PIXABAY_API_KEY=
# Member login OTP on WhatsApp (uses the WhatsApp settings above): the name of an
# "Authentication" template approved by Meta ("{{1}} is your verification code." + a "Copy code" button)
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Admin -> Member Picks "Send a WhatsApp reminder to subscribers": approved template with 3 body values: {{1}} name, {{2}} date, {{3}} stock names
WHATSAPP_PICKS_TEMPLATE=
WHATSAPP_PICKS_TEMPLATE_LANGUAGE=en
# Editing a Member Picks stock that has an Achieved price: approved template with 4 body values: {{1}} date and time of the update, {{2}} name, {{3}} achieved price, {{4}} stock name
WHATSAPP_ACHIEVED_TEMPLATE=
WHATSAPP_ACHIEVED_TEMPLATE_LANGUAGE=en
# Without WhatsApp set up: true shows the OTP on the login page instead of sending it. LOCAL TESTING ONLY - keep false on the live site.
OTP_DEMO=false
# Members are logged out after this many days without opening the site (0 = never)
MEMBER_IDLE_DAYS=1

# With neither key, the admin "Find real photo" button uses free public-domain photos from Openverse (no key needed)
OPENVERSE_ENABLED=true
